# BATON — Environment Configuration Example
# Copy this file to .env for local overrides. Do NOT commit real secrets to .env.

PORT=3000
HOST=127.0.0.1

# Relational SQLite database path (relative to workspace root or absolute)
DB_PATH=./data/baton.db

# Private upload storage directory (kept outside any static public folder)
PRIVATE_STORAGE_DIR=./storage/private_uploads

# Maximum upload size in bytes (default: 2097152 = 2 MB)
MAX_UPLOAD_BYTES=2097152

# Comma-separated list of allowed CORS origins (in addition to localhost)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Automatically seed synthetic demo dataset if database has 0 users on startup
AUTO_SEED_IF_EMPTY=true

# Optional Gemini API key for Stage 2 AI reconstruction proposals
# Leave blank to use the deterministic local structured extraction fallback
GEMINI_API_KEY=your_gemini_api_key_placeholder_here
GEMINI_MODEL=gemini-2.5-flash
